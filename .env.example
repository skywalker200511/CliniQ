# CareTrack - Patient Case-Taking Software (SIH26047)
# Copy this file to .env and fill in values when database is configured

# Database Configuration
VITE_DATABASE_URL=
VITE_DATABASE_KEY=

# API Configuration
VITE_API_URL=http://localhost:3000/api

# Authentication (to be configured later)
VITE_AUTH_PROVIDER=
VITE_AUTH_DOMAIN=
VITE_AUTH_CLIENT_ID=

# Feature Flags
VITE_ENABLE_MOCK_DATA=true
VITE_ENABLE_AI_FEATURES=false
